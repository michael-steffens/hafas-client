{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": false
  },
  "include": [
    "index.ts",
    "throttle.ts",
    "retry.ts",
    "lib/**/*.ts",
    "parse/**/*.ts",
    "format/**/*.ts",
    "p/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test",
    "tools",
    "docs",
    "dist"
  ]
}
